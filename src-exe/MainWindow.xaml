<Window x:Class="RustFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustFix by yawaside · Windows 11 24H2"
        Height="620" Width="900" MinHeight="550" MinWidth="790"
        WindowStartupLocation="CenterScreen"
        Background="#12100F" Foreground="#EFE7DE"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status / Build Card -->
            <RowDefinition Height="*"/>    <!-- Updates List -->
            <RowDefinition Height="Auto"/> <!-- Action Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button x:Name="BtnSettings" DockPanel.Dock="Right" Content="Настройки" Click="BtnSettings_Click"
                    Background="#261F1B" Foreground="#EFE7DE" BorderBrush="#3D322A"
                    Padding="12,6" Cursor="Hand" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2A1B14" BorderBrush="#C75B24" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                    <TextBlock Text="RF" FontWeight="Bold" Foreground="#E8823F"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="RustFix by yawaside" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                    <TextBlock Text="Портативная утилита контроля и удаления обновлений" FontSize="11" Foreground="#8F8379"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- BUILD STATUS CARD (STEP 1) -->
        <Border Grid.Row="1" Background="#1B1715" BorderBrush="#2E2520" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ШАГ 1 · АВТОПРОВЕРКА ВЕРСИИ ОС" FontSize="10" FontWeight="Bold" Foreground="#8F8379"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Текущая сборка: " FontSize="13" Foreground="#B0A499"/>
                        <TextBlock x:Name="TxtDetectedBuild" Text="Проверка..." FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="  |  Эталон: " FontSize="13" Foreground="#8F8379"/>
                        <TextBlock Text="Windows 11 24H2 (26100.8894)" FontSize="13" FontWeight="SemiBold" Foreground="#4FA89A"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtBuildAdvice" Text="Инициализация сканирования системы..." FontSize="12" Foreground="#8F8379" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Verdict Badge -->
                <Border x:Name="BadgeVerdict" Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="6" Background="#211E1D" BorderBrush="#3D322A" BorderThickness="1">
                    <TextBlock x:Name="TxtVerdictBadge" Text="ПРОВЕРКА..." FontWeight="Bold" FontSize="12" Foreground="#8F8379"/>
                </Border>
            </Grid>
        </Border>

        <!-- UPDATES LIST (STEP 2) -->
        <Border Grid.Row="2" Background="#1B1715" BorderBrush="#2E2520" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button x:Name="BtnRescan" DockPanel.Dock="Right" Content="Обновить список" Click="BtnRescan_Click"
                            Background="#261F1B" Foreground="#B0A499" BorderBrush="#3D322A" Padding="8,4" FontSize="11" Cursor="Hand"/>
                    <StackPanel>
                        <TextBlock Text="ШАГ 2 · УСТАНОВЛЕННЫЕ ОБНОВЛЕНИЯ" FontSize="10" FontWeight="Bold" Foreground="#8F8379"/>
                        <TextBlock Text="Включая пакеты CBS, которых нет в HotFix. Защищённые компоненты можно посмотреть, но нельзя выбрать."
                                   FontSize="11" Foreground="#8F8379" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="GridUpdates" Grid.Row="1" Background="#12100F" BorderBrush="#2E2520" BorderThickness="1"
                          Foreground="#EFE7DE" RowBackground="#171312" AlternatingRowBackground="#1B1715"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" AlternationCount="2"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#261F1B">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanAttemptRemove}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="KB" Binding="{Binding KbNumber}" Width="93" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Имя пакета / обновления" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding PackageType}" Width="132" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding InstallDate}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Возможность" Binding="{Binding RemoveHint}" Width="153" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSelectAll" Content="Выбрать доступные" Click="BtnSelectAll_Click" Background="Transparent" Foreground="#B0A499" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDeselectAll" Content="Снять выбор" Click="BtnDeselectAll_Click" Background="Transparent" Foreground="#8F8379" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSelectedCount" Text="Выбрано: 0 обновлений" HorizontalAlignment="Right" Foreground="#8F8379" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ACTION BAR -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar x:Name="ProgBar" Height="4" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed" IsIndeterminate="True" Foreground="#C75B24" Background="#1B1715"/>
            <TextBlock x:Name="TxtStatus" Text="Сканирование..." Foreground="#8F8379" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="BtnDeleteUpdates" Content="УДАЛИТЬ ВЫБРАННЫЕ" Click="BtnDeleteUpdates_Click"
                    Background="#C75B24" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                    BorderThickness="0" Padding="20,10" HorizontalAlignment="Right" Cursor="Hand" IsEnabled="False">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>
    </Grid>
</Window>
