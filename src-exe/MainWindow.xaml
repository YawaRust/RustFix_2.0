<Window x:Class="RustFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RustFix by YAWASIDE x TRIAGED"
        Icon="Assets/RustFix.jpg"
        Height="660" Width="1130" MinHeight="560" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#110F0E" Foreground="#EFE7DE"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        ToolTipService.InitialShowDelay="450" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="12000">

    <!-- GlassFrameThickness=0 removes the white native band that WPF draws
         above a WindowStyle=None window; CaptionHeight=0 gives us the custom titlebar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#44352B" BorderThickness="1" Background="#110F0E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom dark titlebar replaces the native white window chrome. -->
            <Grid Grid.Row="0" Background="#191411" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/RustFix.jpg" Width="18" Height="18" Margin="11,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="RustFix by YAWASIDE x TRIAGED" VerticalAlignment="Center" FontSize="12" Foreground="#CFC2B8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButton}" Content="—" Click="BtnMinimize_Click" ToolTip="Свернуть"/>
                    <Button Style="{StaticResource CloseTitleButton}" Content="×" FontSize="18" Click="BtnClose_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSettings" Style="{StaticResource ButtonBase}" Content="Настройки" Click="BtnSettings_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnTelegram" Style="{StaticResource PatinaButton}" Content="Telegram ↗" Click="BtnTelegram_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" Background="#2A1A13" BorderBrush="#C75B24" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                            <Image Source="Assets/RustFix.jpg" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="RustFix by YAWASIDE x TRIAGED" FontWeight="Bold" FontSize="17" Foreground="#FFFFFF"/>
                            <TextBlock Text="Портативная утилита контроля и удаления обновлений" FontSize="11" Foreground="#95877B"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Automatic build check -->
                <Border Grid.Row="1" Grid.Column="0" Background="#181412" BorderBrush="#342A23" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ШАГ 1 · АВТОСКАН ВЕРСИИ WINDOWS" FontSize="10" FontWeight="Bold" Foreground="#94877D"/>
                            <WrapPanel Margin="0,5,12,0">
                                <TextBlock Text="Текущая сборка: " Foreground="#B8AAA0"/>
                                <TextBlock x:Name="TxtDetectedBuild" Text="Сканирование..." FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                <TextBlock Text="Эталон: " Foreground="#94877D"/>
                                <TextBlock Text="Windows 11 24H2 (26100.8894)" FontWeight="SemiBold" Foreground="#4FA89A"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtBuildAdvice" Text="Чтение реестра и проверка установленной ветки..." FontSize="12" Foreground="#93857B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtPrivileges" Text="Режим суперпользователя: проверка прав..." FontSize="11"
                                       Foreground="#4FA89A" Margin="0,6,0,0" TextWrapping="Wrap"
                                       ToolTip="Администратор + SeTakeOwnership, SeBackup, SeRestore, SeDebug. Без этих прав Windows не даёт снять защищённые KB."/>
                        </StackPanel>
                        <Border x:Name="BadgeVerdict" Grid.Column="1" VerticalAlignment="Center" Padding="12,7" CornerRadius="5" Background="#211A17" BorderBrush="#44352B" BorderThickness="1">
                            <TextBlock x:Name="TxtVerdictBadge" Text="СКАНИРОВАНИЕ..." FontWeight="Bold" FontSize="11" Foreground="#94877D"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Updates table -->
                <Border Grid.Row="2" Grid.Column="0" Background="#181412" BorderBrush="#342A23" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="ШАГ 2 · УСТАНОВЛЕННЫЕ ОБНОВЛЕНИЯ" FontSize="10" FontWeight="Bold" Foreground="#94877D"/>
                                <TextBlock Text="Обычные KB можно выбрать. Скрытые компоненты CBS показаны отдельно; защищённые пакеты заблокированы Windows."
                                           FontSize="12" Foreground="#93857B" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <CheckBox x:Name="ChkThreeLayer" Content="Гарантированное снятие · 3 уровня" IsChecked="True"
                                          Foreground="#B6A89D" Margin="0,0,12,0"
                                          ToolTip="DISM /Remove-Package → wusa /kb → принудительное владение файлами служб обслуживания. Третий уровень снимает даже KB, помеченные Windows как неудаляемые."/>
                                <Button x:Name="BtnRescan" Style="{StaticResource ButtonBase}"
                                        Content="↻ Обновить список" Click="BtnRescan_Click"
                                        Padding="9,5" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- Type filters, same as the web preview. -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChip}" GroupName="UpdFilter"
                                         Tag="all" IsChecked="True" Checked="Filter_Checked" Content="Все"/>
                            <RadioButton x:Name="FilterKb" Style="{StaticResource FilterChip}" GroupName="UpdFilter"
                                         Tag="kb" Checked="Filter_Checked" Content="Обычные KB"/>
                            <RadioButton x:Name="FilterHidden" Style="{StaticResource FilterChip}" GroupName="UpdFilter"
                                         Tag="hidden" Checked="Filter_Checked" Content="Скрытые CBS"/>
                            <RadioButton x:Name="FilterRemovable" Style="{StaticResource FilterChip}" GroupName="UpdFilter"
                                         Tag="removable" Checked="Filter_Checked" Content="Можно удалить"/>
                        </StackPanel>

                        <DataGrid x:Name="GridUpdates" Grid.Row="2" Grid.Column="0"
                                  Background="#120F0E" BorderBrush="#342A23" BorderThickness="1"
                                  Foreground="#EFE7DE" RowBackground="#171312" AlternatingRowBackground="#1B1715"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" IsReadOnly="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A211C"
                                  SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="38">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRemove}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding RemovalStatus}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="KB / ПАКЕТ" Binding="{Binding KbNumber}" Width="115" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8823F"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="ОБНОВЛЕНИЕ И ОПИСАНИЕ" Width="*" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,3" ToolTip="{Binding Description}">
                                                <TextBlock Text="{Binding Title}" Foreground="#E9DFD6"
                                                           FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#8B7E74"
                                                           FontSize="11" Margin="0,1,0,0" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ИСТОЧНИК" Binding="{Binding PackageType}" Width="135" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A99B90"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ДАТА" Binding="{Binding InstallDate}" Width="96" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#93857B"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ВОЗМОЖНОСТЬ" Binding="{Binding RemovalStatus}" Width="145" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4FA89A"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,9,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource LinkButton}" Content="Выбрать доступные" Click="BtnSelectAll_Click" Margin="0,0,16,0"/>
                                <Button Style="{StaticResource LinkButton}" Content="Снять выбор" Click="BtnDeselectAll_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSelectedCount" Text="Найдено: 0 · Выбрано: 0" HorizontalAlignment="Right" Foreground="#93857B" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>

                    </Grid>
                </Border>

                <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
                    <ProgressBar x:Name="ProgBar" Height="4" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed" IsIndeterminate="True" Foreground="#C75B24" Background="#211A17"/>
                    <TextBlock x:Name="TxtStatus" Text="Сканирование будет запущено автоматически"
                               Foreground="#93857B" VerticalAlignment="Center" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <Button x:Name="BtnDeleteUpdates" Style="{StaticResource AccentButton}" Content="УДАЛИТЬ ВЫБРАННЫЕ ОБНОВЛЕНИЯ" Click="BtnDeleteUpdates_Click" Padding="20,10" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Information panel is a sibling of the main content, never over the table. -->
                <Border Grid.Row="1" Grid.Column="2" Grid.RowSpan="3"
                        Background="#181412" BorderBrush="#342A23" BorderThickness="1"
                        CornerRadius="8" Padding="14" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel>
                            <TextBlock Text="ПОЛЕЗНАЯ ИНФОРМАЦИЯ" FontSize="10" FontWeight="Bold" Foreground="#94877D"/>

                            <Border Width="96" Height="96" CornerRadius="48"
                                    BorderBrush="#C75B24" BorderThickness="2" Background="#221A16"
                                    HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Image Source="Assets/Author.jpg" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <TextBlock Text="TRIAGED" FontWeight="Bold" Foreground="#FFFFFF"
                                       FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="создано командой YAWASIDE" FontSize="11" Foreground="#776C62"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>

                            <TextBlock FontSize="11.5" Foreground="#9A8D82" TextWrapping="Wrap"
                                       LineHeight="17" TextAlignment="Center" Margin="0,14,0,0">
                                RustFix создан для исправления проблем, связанных с нестабильными обновлениями Windows. Приложение находит обычные и скрытые обновления CBS и откатывает их в 3 уровня. Если возникнут проблемы с приложением — вы всегда можете обратиться в Telegram.
                            </TextBlock>

                            <Button x:Name="BtnYoutube" Style="{StaticResource YoutubeButton}"
                                    Content="▶  YouTube · triaged_rust" Click="BtnYoutube_Click"
                                    HorizontalAlignment="Stretch" Margin="0,14,0,0"/>
                            <Button x:Name="BtnInfoTelegram" Style="{StaticResource PatinaButton}"
                                    Content="✈  Telegram · TriagedRust" Click="BtnTelegram_Click"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>