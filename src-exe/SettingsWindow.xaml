<Window x:Class="RustFix.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustFix by yawaside"
        Icon="Assets/RustFix.jpg"
        Height="490" Width="660" MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#110F0E" Foreground="#EFE7DE"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Border Background="#110F0E" BorderBrush="#44352B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#191411" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/RustFix.jpg" Width="18" Height="18" Margin="11,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="RustFix by yawaside · Настройки" VerticalAlignment="Center" Foreground="#CFC2B8" FontSize="12"/>
                <Button Grid.Column="2" Style="{StaticResource CloseTitleButton}" Content="×" FontSize="18" Click="BtnClose_Click" ToolTip="Закрыть"/>
            </Grid>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="ОБЩИЕ НАСТРОЙКИ И ОБСЛУЖИВАНИЕ" FontWeight="Bold" FontSize="13" Foreground="#E8823F"/>
                    <TextBlock Text="Пауза обновлений, восстановление системы и рекомендации при неудачном откате." Foreground="#91847A" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <TabControl Grid.Row="1" Background="#181412" BorderBrush="#342A23">
                    <TabItem Header="Пауза и отключение">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#181412">
                            <StackPanel Margin="15">
                                <TextBlock Text="ПРИОСТАНОВКА ОБНОВЛЕНИЙ" FontWeight="Bold" Foreground="#C4B7AB" Margin="0,0,0,5"/>
                                <TextBlock Text="Записывает даты паузы в Центр обновления, чтобы пакеты не установились повторно." FontSize="11" Foreground="#8F8379" TextWrapping="Wrap" Margin="0,0,0,9"/>
                                <UniformGrid Columns="4" Margin="0,0,0,15">
                                    <Button Style="{StaticResource ButtonBase}" Content="7 дней" Click="BtnPause7_Click" Margin="2"/>
                                    <Button Style="{StaticResource ButtonBase}" Content="4 недели" Click="BtnPause28_Click" Margin="2"/>
                                    <Button Style="{StaticResource ButtonBase}" Content="35 недель" Click="BtnPause245_Click" Margin="2"/>
                                    <Button Style="{StaticResource ButtonBase}" Content="Снять паузу" Click="BtnPause0_Click" Margin="2"/>
                                </UniformGrid>

                                <TextBlock Text="ПОЛНОЕ ОТКЛЮЧЕНИЕ ЦЕНТРА ОБНОВЛЕНИЙ" FontWeight="Bold" Foreground="#C4B7AB" Margin="0,3,0,7"/>
                                <CheckBox x:Name="ChkNoAutoUpdate" Content="Запретить автоматическую проверку обновлений (NoAutoUpdate = 1)" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="ChkDisableServices" Content="Отключить службы wuauserv, UsoSvc и BITS" Margin="0,3"/>
                                <CheckBox x:Name="ChkNoReboot" Content="Запретить автоматическую перезагрузку" IsChecked="True" Margin="0,3"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="ПРИМЕНИТЬ" Click="BtnApplyPolicies_Click" Margin="0,0,9,0"/>
                                    <Button Style="{StaticResource PatinaButton}" Content="Восстановить штатный режим" Click="BtnRestoreDefaults_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Если откат не помог">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#181412">
                            <StackPanel Margin="15">
                                <Border Background="#2A1712" BorderBrush="#A94A2B" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,13">
                                    <TextBlock Text="Если wusa и DISM не могут снять пакет либо стоит другая ветка ОС, используйте чистую установку Windows 11 24H2 (26100.8894)." TextWrapping="Wrap" Foreground="#E8D8CC" FontSize="11.5"/>
                                </Border>
                                <TextBlock Text="РЕКОМЕНДУЕМЫЙ ПОРЯДОК ДЕЙСТВИЙ" FontWeight="Bold" Foreground="#C4B7AB" Margin="0,0,0,6"/>
                                <TextBlock Text="1. Перезагрузите ПК и повторите удаление в RustFix — отложенные блокировки часто снимаются после ребута." TextWrapping="Wrap" Foreground="#93857B" Margin="0,3"/>
                                <TextBlock Text="2. Выполните: dism /online /cleanup-image /restorehealth." TextWrapping="Wrap" Foreground="#93857B" Margin="0,3"/>
                                <TextBlock Text="3. Скачайте чистый образ Windows 11 24H2 и запустите setup.exe с сохранением личных файлов." TextWrapping="Wrap" Foreground="#93857B" Margin="0,3"/>
                                <Button Style="{StaticResource AccentButton}" Content="Скачать стабильный билд 24H2 (Microsoft) ↗" Click="BtnMsDownload_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="О программе">
                        <StackPanel Margin="15">
                            <TextBlock Text="RustFix by yawaside" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                            <TextBlock Text="Портативная утилита для Windows 11 24H2 · цель 26100.8894" Foreground="#4FA89A" Margin="0,3,0,13"/>
                            <TextBlock Text="Автоматически читает сборку системы, сканирует обычные и скрытые пакеты CBS/DISM, показывает защищённые компоненты отдельно и позволяет снимать доступные обновления." TextWrapping="Wrap" Foreground="#93857B"/>
                            <Border Background="#1D1714" BorderBrush="#3C3028" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Официальный Telegram-канал" FontWeight="Bold" Foreground="#E8823F"/>
                                    <TextBlock Text="https://t.me/TriagedRust" Foreground="#4FA89A" FontSize="13" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonDown="TelegramLink_Click" Margin="0,4,0,0"/>
                                    <TextBlock Text="Помощь с дампами, сбоями Windows и проблемными обновлениями." FontSize="10" Foreground="#857970" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <Button Grid.Row="2" Style="{StaticResource ButtonBase}" Content="Закрыть" Click="BtnClose_Click" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>