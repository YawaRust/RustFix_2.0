<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>RustFix</AssemblyName>
    <RootNamespace>RustFix</RootNamespace>
    <AssemblyTitle>RustFix by yawaside</AssemblyTitle>
    <Product>RustFix</Product>
    <Version>1.5.0</Version>

    <!-- Портативный single-file EXE: всё внутри одного файла, установка не нужна -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI-сканирование установленных обновлений (Win32_QuickFixEngineering) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
